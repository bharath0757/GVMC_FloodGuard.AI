# ================================
# FloodGuard AI - Environment Variables
# ================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=
VITE_APP_NAME=FloodGuard AI

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/floodguard
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# External APIs
OPENWEATHERMAP_API_KEY=
IMD_API_KEY=
MAPBOX_ACCESS_TOKEN=

# AWS (Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
